{
  "name": "glimp",
  "displayName": "Glimp",
  "description": "Open GitHub repositories without cloning.",
  "version": "0.2.0",
  "publisher": "glimp",
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "github",
    "repository",
    "remote",
    "readonly"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onFileSystem:glimp"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "glimp.openRepository",
        "title": "Open Repository",
        "category": "Glimp",
        "icon": "$(repo)"
      },
      {
        "command": "glimp.switchBranch",
        "title": "Switch Branch",
        "category": "Glimp",
        "icon": "$(git-branch)"
      },
      {
        "command": "glimp.refresh",
        "title": "Refresh Repository",
        "category": "Glimp",
        "icon": "$(refresh)"
      },
      {
        "command": "glimp.signIn",
        "title": "Sign In to GitHub",
        "category": "Glimp"
      },
      {
        "command": "glimp.openOnGitHub",
        "title": "Open on GitHub",
        "category": "Glimp",
        "icon": "$(link-external)"
      },
      {
        "command": "glimp.openSettings",
        "title": "Open Settings",
        "category": "Glimp",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "glimp.openOnGitHub",
          "when": "resourceScheme == glimp",
          "group": "glimp@1"
        },
        {
          "command": "glimp.switchBranch",
          "when": "resourceScheme == glimp",
          "group": "glimp@2"
        },
        {
          "command": "glimp.refresh",
          "when": "resourceScheme == glimp",
          "group": "glimp@3"
        },
        {
          "command": "glimp.openSettings",
          "when": "resourceScheme == glimp",
          "group": "glimp@4"
        }
      ]
    },
    "configuration": {
      "title": "Glimp",
      "properties": {
        "glimp.defaultBranch": {
          "type": "string",
          "default": "",
          "description": "Branch to open. Leave empty to use the repository's default branch.",
          "scope": "window",
          "order": 1
        },
        "glimp.maxFileSize": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Largest file to open, in MiB.",
          "scope": "window",
          "order": 2
        },
        "glimp.cacheSize": {
          "type": "integer",
          "default": 32,
          "minimum": 0,
          "maximum": 256,
          "description": "File cache size per open repository branch, in MiB. Set to 0 to disable caching.",
          "scope": "window",
          "order": 3
        },
        "glimp.requestTimeout": {
          "type": "integer",
          "default": 15,
          "minimum": 1,
          "maximum": 120,
          "description": "Time to wait for each GitHub request, in seconds.",
          "scope": "window",
          "order": 4
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "Browse a GitHub repository without cloning.\n[Open Repository](command:glimp.openRepository)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=browser --format=cjs --target=es2022 --external:vscode --sourcemap --sources-content=false --legal-comments=none --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json .prettierrc.json .vscode",
    "format:check": "prettier --check src package.json tsconfig.json .prettierrc.json .vscode",
    "check": "npm run typecheck && npm run format:check && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out ../glimp-0.2.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "octokit": "^5.0.5"
  }
}
