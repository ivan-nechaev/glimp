{
  "name": "glimp",
  "displayName": "Glimp",
  "description": "Open GitHub repositories without cloning.",
  "version": "0.1.0",
  "publisher": "glimp",
  "engines": {
    "vscode": "^1.99.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "github",
    "repository",
    "remote",
    "readonly"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onFileSystem:glimp"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "glimp.openRepository",
        "title": "Open Repository",
        "category": "Glimp",
        "icon": "$(repo)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "explorer",
        "contents": "Browse a GitHub repository without cloning.\n[Open Repository](command:glimp.openRepository)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=es2022 --external:vscode --sourcemap --sources-content=false --legal-comments=none --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src package.json tsconfig.json .prettierrc.json .vscode",
    "format:check": "prettier --check src package.json tsconfig.json .prettierrc.json .vscode",
    "check": "npm run typecheck && npm run format:check && npm run build",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license --out ../glimp-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "octokit": "^5.0.5"
  }
}
